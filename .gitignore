# Data: в git только ручная разметка и сплиты, всё остальное (сырые снимки,
# processed, YOLO-датасеты) — слишком большое и воспроизводится скриптами
data/*
!data/annotations/
!data/splits/

# Аннотации хранятся без встроенных изображений (imageData=null) — снимки не коммитим
data/annotations/*.png
data/annotations/*.jpg
data/annotations/*.jpeg

